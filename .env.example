# Copy this file to ".env" (same folder) and fill in what you have.
# ".env" is ignored by git, so your keys are never uploaded. NEVER paste keys into chats, issues or commits.

# --- AI: use ONE of these -------------------------------------------------
# Free Groq key: https://console.groq.com/keys  (starts with gsk_). Easiest: run ./scripts/set-key.sh
GROQ_API_KEY=
# Free Gemini key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: force a provider (gemini or anthropic) or a model name
# MEDBRIDGE_LLM=groq   (or gemini, anthropic, openai_compat)
# Any OpenAI-compatible server, e.g. Ollama on your own computer (no key, fully private):
# MEDBRIDGE_LLM=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# MEDBRIDGE_MODEL=   (leave empty: the app picks a current model for your provider)

# --- SMS (needed from Phase 4): https://console.twilio.com ----------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# MEDBRIDGE_PUBLIC_URL=https://your-tunnel.ngrok-free.app   (so Twilio can send replies to the app)
# --- Telegram bot (free phone messages, no carrier approval): create one with @BotFather in Telegram -----
# TELEGRAM_BOT_TOKEN=
# MEDBRIDGE_TELEGRAM=off   (stops listening for Telegram messages)

# --- Care-team page (Phase 5): an access code for the dashboard. Letters and digits only. -----------
# MEDBRIDGE_TEAM_KEY=
# --- Reminder timer: the time zone to use when a patient's browser does not say (default America/Los_Angeles) ---
# MEDBRIDGE_TZ=America/Chicago
# MEDBRIDGE_SCHEDULER=off   (turns the reminder timer off)
