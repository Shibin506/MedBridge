# Copy this file to ".env" (same folder) and fill in what you have.
# ".env" is ignored by git, so your keys are never uploaded. NEVER paste keys into chats, issues or commits.

# --- AI: use ONE of these -------------------------------------------------
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: force a provider (gemini or anthropic) or a model name
# MEDBRIDGE_LLM=gemini
# MEDBRIDGE_MODEL=   (leave empty: the app picks a current Gemini Flash model)

# --- SMS (needed from Phase 4): https://console.twilio.com ----------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
